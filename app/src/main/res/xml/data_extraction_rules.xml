<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup & device transfer rules (API 31+, dataExtractionRules).
  All app data (Room DB, DataStore) is non-sensitive and included by
  default; declared explicitly per Play/Android guidance.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
